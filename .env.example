# Database
POSTGRES_DB=blueprintai
POSTGRES_USER=blueprintai
POSTGRES_PASSWORD=blueprintai
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-in-production-use-a-secure-256-bit-secret-key

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=BlueprintAI

# AI Providers — put your real key in .env only (never commit it)
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=false
CLAUDE_MODEL=claude-3-5-haiku-20241022
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
