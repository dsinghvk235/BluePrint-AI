# Database
POSTGRES_DB=blueprintai
POSTGRES_USER=blueprintai
POSTGRES_PASSWORD=blueprintai
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-in-production-use-a-secure-256-bit-secret-key

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=BlueprintAI

# AI Providers — put your real key in .env only (never commit it)
# Local Ollama (no API key): install from https://ollama.com then `ollama pull llama3.2`
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=false
CLAUDE_MODEL=claude-3-5-haiku-20241022
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
